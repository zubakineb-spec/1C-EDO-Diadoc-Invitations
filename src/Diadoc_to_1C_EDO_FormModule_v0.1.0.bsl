#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	НастроитьИнтерфейсФормы();

КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)

	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Предупреждение("Выберите организацию, от имени которой будет выполняться приглашение в 1С-ЭДО.");
		Возврат;
	КонецЕсли;

	Попытка
		ЗагрузитьКонтрагентовДиадокНаСервере();
	Исключение
		Если Не ТребуетсяВыбратьФайлМодуляДиадок(ОписаниеОшибки()) Тогда
			Предупреждение(ОписаниеОшибки());
			Возврат;
		КонецЕсли;

		Если Не ВыбратьИПоместитьМодульДиадок() Тогда
			Возврат;
		КонецЕсли;

		Попытка
			ЗагрузитьКонтрагентовДиадокНаСервере();
		Исключение
			Предупреждение(
				"Не удалось получить контрагентов из модуля Контур.Диадок." + Символы.ПС
				+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			Возврат;
		КонецПопытки;
	КонецПопытки;

	Элементы.ФормаСоздатьДокументы.Доступность = ПолучитьКоличествоВыбранныхНаСервере() > 0;

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументы(Команда)

	ДанныеПередачи = ПолучитьДанныеДляПомощникаЭДОНаСервере();

	Если ДанныеПередачи.Контрагенты.Количество() = 0 Тогда
		Предупреждение("Не выбрано ни одного сопоставленного контрагента.");
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);

	// Разные редакции БЭД/1С-ЭДО использовали разные имена входных параметров.
	// Передаем безопасные алиасы одного и того же списка. Неизвестные параметры
	// управляемая форма игнорирует.
	ПараметрыФормы.Вставить("Контрагенты", ДанныеПередачи.Контрагенты);
	ПараметрыФормы.Вставить("СписокКонтрагентов", ДанныеПередачи.Контрагенты);
	ПараметрыФормы.Вставить("МассивКонтрагентов", ДанныеПередачи.Контрагенты);
	ПараметрыФормы.Вставить("ВыбранныеКонтрагенты", ДанныеПередачи.Контрагенты);
	ПараметрыФормы.Вставить("ДанныеКонтрагентов", ДанныеПередачи.ДанныеКонтрагентов);

	Попытка
		ОткрытьФорму(
			"РегистрСведений.ПриглашенияКОбменуЭлектроннымиДокументами.Форма.ПомощникМассовойОтправкиПриглашений",
			ПараметрыФормы,
			ЭтаФорма);
	Исключение
		Предупреждение(
			"Не удалось открыть штатный помощник массовой отправки приглашений 1С-ЭДО." + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НастроитьИнтерфейсФормы()

	ДобавляемыеРеквизиты = Новый Массив;
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("АдресМодуляДиадок", Новый ОписаниеТипов("Строка")));
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("ИмяФайлаМодуляДиадок", Новый ОписаниеТипов("Строка")));
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("Информация", Новый ОписаниеТипов("Строка")));
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("КандидатыЭДО", Новый ОписаниеТипов("ТаблицаЗначений")));

	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("Отправлять", Новый ОписаниеТипов("Булево"), "КандидатыЭДО"));
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"), "КандидатыЭДО"));
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("НаименованиеДиадок", Новый ОписаниеТипов("Строка"), "КандидатыЭДО"));
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("ИНН", Новый ОписаниеТипов("Строка"), "КандидатыЭДО"));
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("КПП", Новый ОписаниеТипов("Строка"), "КандидатыЭДО"));
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("BoxId", Новый ОписаниеТипов("Строка"), "КандидатыЭДО"));
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("ИдентификаторУчастникаЭДО", Новый ОписаниеТипов("Строка"), "КандидатыЭДО"));
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("СтатусДиадок", Новый ОписаниеТипов("Строка"), "КандидатыЭДО"));
	ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("Результат", Новый ОписаниеТипов("Строка"), "КандидатыЭДО"));

	ИзменитьРеквизиты(ДобавляемыеРеквизиты);

	Элементы.Период.Видимость = Ложь;
	Элементы.Подразделение.Видимость = Ложь;
	Элементы.Группа2.Видимость = Ложь;
	Элементы.Группа3.Видимость = Ложь;
	Элементы.Группа4.Видимость = Ложь;
	Элементы.ДанныеСчетов.Видимость = Ложь;

	Элементы.ФормаЗаполнить.Заголовок = "Получить из Диадок";
	Элементы.ФормаСоздатьДокументы.Заголовок = "Передать в 1С-ЭДО";
	Элементы.ФормаСоздатьДокументы.Доступность = Ложь;

	ПолеИнформация = Элементы.Добавить("ИнформацияЭДО", Тип("ПолеФормы"), Элементы.Группа1);
	ПолеИнформация.ПутьКДанным = "Информация";
	ПолеИнформация.Вид = ВидПоляФормы.ПолеВвода;
	ПолеИнформация.ТолькоПросмотр = Истина;

	ТаблицаФормы = Элементы.Добавить("КандидатыЭДОТаблица", Тип("ТаблицаФормы"), Элементы.Группа1);
	ТаблицаФормы.ПутьКДанным = "КандидатыЭДО";

	ДобавитьКолонкуФормы(ТаблицаФормы, "Отправлять", "Отправить", Ложь, ВидПоляФормы.ПолеФлажка);
	ДобавитьКолонкуФормы(ТаблицаФормы, "Контрагент", "Контрагент 1С", Истина);
	ДобавитьКолонкуФормы(ТаблицаФормы, "НаименованиеДиадок", "Контрагент в Диадок", Истина);
	ДобавитьКолонкуФормы(ТаблицаФормы, "ИНН", "ИНН", Истина);
	ДобавитьКолонкуФормы(ТаблицаФормы, "КПП", "КПП", Истина);
	ДобавитьКолонкуФормы(ТаблицаФормы, "ИдентификаторУчастникаЭДО", "ID участника ЭДО", Истина);
	ДобавитьКолонкуФормы(ТаблицаФормы, "СтатусДиадок", "Статус Диадок", Истина);
	ДобавитьКолонкуФормы(ТаблицаФормы, "Результат", "Результат отбора", Истина);

	Информация =
		"1. Выберите организацию. 2. Нажмите «Получить из Диадок». "
		+ "3. Проверьте список и передайте выбранных контрагентов в штатный помощник 1С-ЭДО.";

КонецПроцедуры

&НаСервере
Процедура ДобавитьКолонкуФормы(ТаблицаФормы, ИмяРеквизита, Заголовок, ТолькоПросмотр, ВидПоля = Неопределено)

	ИмяЭлемента = "КандидатыЭДО" + ИмяРеквизита;
	Поле = Элементы.Добавить(ИмяЭлемента, Тип("ПолеФормы"), ТаблицаФормы);
	Поле.ПутьКДанным = "КандидатыЭДО." + ИмяРеквизита;
	Поле.Заголовок = Заголовок;
	Поле.ТолькоПросмотр = ТолькоПросмотр;

	Если ВидПоля <> Неопределено Тогда
		Поле.Вид = ВидПоля;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция ВыбратьИПоместитьМодульДиадок()

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Выберите установленный модуль Контур.Диадок";
	Диалог.Фильтр = "Внешняя обработка (*.epf)|*.epf";
	Диалог.МножественныйВыбор = Ложь;

	Если Не Диалог.Выбрать() Тогда
		Возврат Ложь;
	КонецЕсли;

	НовыйАдрес = "";
	Если Не ПоместитьФайл(НовыйАдрес, Диалог.ПолноеИмяФайла, , Ложь) Тогда
		Предупреждение("Не удалось поместить модуль Диадок во временное хранилище.");
		Возврат Ложь;
	КонецЕсли;

	АдресМодуляДиадок = НовыйАдрес;
	ИмяФайлаМодуляДиадок = Диалог.ПолноеИмяФайла;

	Возврат Истина;

КонецФункции

&НаКлиентеБезКонтекста
Функция ТребуетсяВыбратьФайлМодуляДиадок(ТекстОшибки)

	ТекстОшибкиНРег = НРег(ТекстОшибки);

	Возврат СтрНайти(ТекстОшибкиНРег, "контурэдо") > 0
		Или СтрНайти(ТекстОшибкиНРег, "внешн") > 0
		Или СтрНайти(ТекстОшибкиНРег, "модул") > 0;

КонецФункции

&НаСервере
Процедура ЗагрузитьКонтрагентовДиадокНаСервере()

	Кандидаты = СоздатьТаблицуКандидатов();
	ДиадокОбъект = ПолучитьОбъектМодуляДиадок();

	ДиадокОбъект.ИнициализироватьОбщийКонтекст();
	Ядро = ДиадокОбъект.Модуль_Ядро();

	ИдентификаторыОрганизации = Ядро.Новый_ИдентификаторыСправочника(, Объект.Организация);
	ДанныеОрганизации = Ядро.Организации_ЗаполненныеРеквизиты(ИдентификаторыОрганизации);

	Если Не ЗначениеЗаполнено(ДанныеОрганизации) Тогда
		ВызватьИсключение "Организация не сопоставлена с организацией/ящиком в модуле Контур.Диадок.";
	КонецЕсли;

	Ядро.Контрагенты_ВыполнитьСинхронизациюОсновныхСтатусов(ДанныеОрганизации);

	Статусы = Новый Массив;
	СтатусПартнера = Ядро.Перечисление_СтатусыКонтрагентов().ПартнерскиеОтношения;
	Статусы.Добавить(СтатусПартнера);

	// Сопоставление выполняется штатным алгоритмом модуля Диадок.
	// Ошибка сопоставления не должна мешать показать уже существующие связи.
	Попытка
		Ядро.Контрагенты_ГрупповоеСопоставлениеV2(ДанныеОрганизации, Статусы);
	Исключение
	КонецПопытки;

	СписокДиадок = Ядро.Контрагенты_СписокДляРазделаВашиКонтрагенты(ДанныеОрганизации);

	КоличествоПартнеров = 0;
	КоличествоГотовых = 0;
	КоличествоНеСопоставленных = 0;
	КоличествоНеоднозначных = 0;

	Для Каждого СтрокаДиадок Из СписокДиадок Цикл

		ДанныеСтроки = Новый Структура(
			"ID,Наименование,ИНН,КПП,ИдентификаторУчастникаЭДО,Статус,РеквизитыСвязанныхСправочников,ДатаЛиквидации");
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаДиадок);

		Если ДанныеСтроки.Статус <> СтатусПартнера Тогда
			Продолжить;
		КонецЕсли;

		КоличествоПартнеров = КоличествоПартнеров + 1;

		Связи = ДанныеСтроки.РеквизитыСвязанныхСправочников;
		Если Связи = Неопределено Тогда
			Связи = Новый Массив;
		КонецЕсли;

		Если Связи.Количество() = 0 Тогда
			ДобавитьКандидата(
				Кандидаты, ДанныеСтроки, Неопределено, Ложь,
				"Не сопоставлен со справочником Контрагенты 1С");
			КоличествоНеСопоставленных = КоличествоНеСопоставленных + 1;
			Продолжить;
		КонецЕсли;

		Если Связи.Количество() > 1 Тогда
			ДобавитьКандидата(
				Кандидаты, ДанныеСтроки, Неопределено, Ложь,
				"Найдено несколько сопоставлений в 1С — требуется проверка");
			КоличествоНеоднозначных = КоличествоНеоднозначных + 1;
			Продолжить;
		КонецЕсли;

		Связь = Связи[0];
		Контрагент = Неопределено;
		Попытка
			Контрагент = Связь.Ссылка;
		Исключение
		КонецПопытки;

		Если Не ЗначениеЗаполнено(Контрагент) Тогда
			ДобавитьКандидата(
				Кандидаты, ДанныеСтроки, Неопределено, Ложь,
				"Сопоставление Диадок не содержит ссылки на контрагента 1С");
			КоличествоНеСопоставленных = КоличествоНеСопоставленных + 1;
			Продолжить;
		КонецЕсли;

		Если ЗначениеЗаполнено(ДанныеСтроки.ДатаЛиквидации) Тогда
			ДобавитьКандидата(
				Кандидаты, ДанныеСтроки, Контрагент, Ложь,
				"Организация в Диадоке отмечена как ликвидированная");
			Продолжить;
		КонецЕсли;

		ДобавитьКандидата(
			Кандидаты, ДанныеСтроки, Контрагент, Истина,
			"Готов к проверке штатным помощником 1С-ЭДО");
		КоличествоГотовых = КоличествоГотовых + 1;

	КонецЦикла;

	ЗначениеВРеквизитФормы(Кандидаты, "КандидатыЭДО");

	Информация = СтрШаблон(
		"Диадок: действующих партнеров — %1; готово к передаче в 1С-ЭДО — %2; не сопоставлено — %3; неоднозначно — %4. "
		+ "Перед отправкой штатный помощник 1С-ЭДО дополнительно проверит наличие учетной записи и состояние приглашения.",
		КоличествоПартнеров,
		КоличествоГотовых,
		КоличествоНеСопоставленных,
		КоличествоНеоднозначных);

КонецПроцедуры

&НаСервере
Функция ПолучитьОбъектМодуляДиадок()

	// Если Контур.Диадок уже был подключен в текущем сеансе, используем его.
	Попытка
		ДиадокОбъект = ВнешниеОбработки.Создать("КонтурЭДО");
		Возврат ДиадокОбъект;
	Исключение
	КонецПопытки;

	Если ПустаяСтрока(АдресМодуляДиадок) Тогда
		ВызватьИсключение
			"Модуль КонтурЭДО еще не подключен в текущем сеансе. Выберите файл установленного модуля Диадок.";
	КонецЕсли;

	// Подключение через временное хранилище — штатный механизм платформы 1С.
	// Безопасный режим отключается, потому что официальный модуль Диадок выполняет HTTP-вызовы.
	ИмяПодключеннойОбработки = ВнешниеОбработки.Подключить(АдресМодуляДиадок, , Ложь);
	ДиадокОбъект = ВнешниеОбработки.Создать(ИмяПодключеннойОбработки);

	Возврат ДиадокОбъект;

КонецФункции

&НаСервереБезКонтекста
Функция СоздатьТаблицуКандидатов()

	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Отправлять", Новый ОписаниеТипов("Булево"));
	Результат.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	Результат.Колонки.Добавить("НаименованиеДиадок", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ИНН", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("КПП", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("BoxId", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("ИдентификаторУчастникаЭДО", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("СтатусДиадок", Новый ОписаниеТипов("Строка"));
	Результат.Колонки.Добавить("Результат", Новый ОписаниеТипов("Строка"));

	Возврат Результат;

КонецФункции

&НаСервереБезКонтекста
Процедура ДобавитьКандидата(ТаблицаКандидатов, ДанныеДиадок, Контрагент, Отправлять, ТекстРезультата)

	НоваяСтрока = ТаблицаКандидатов.Добавить();
	НоваяСтрока.Отправлять = Отправлять;
	НоваяСтрока.Контрагент = Контрагент;
	НоваяСтрока.НаименованиеДиадок = ДанныеДиадок.Наименование;
	НоваяСтрока.ИНН = ДанныеДиадок.ИНН;
	НоваяСтрока.КПП = ДанныеДиадок.КПП;
	НоваяСтрока.BoxId = ДанныеДиадок.ID;
	НоваяСтрока.ИдентификаторУчастникаЭДО = ДанныеДиадок.ИдентификаторУчастникаЭДО;
	НоваяСтрока.СтатусДиадок = "IsMyCounteragent";
	НоваяСтрока.Результат = ТекстРезультата;

КонецПроцедуры

&НаСервере
Функция ПолучитьКоличествоВыбранныхНаСервере()

	Кандидаты = РеквизитФормыВЗначение("КандидатыЭДО", Тип("ТаблицаЗначений"));
	Количество = 0;

	Для Каждого СтрокаКандидата Из Кандидаты Цикл
		Если СтрокаКандидата.Отправлять И ЗначениеЗаполнено(СтрокаКандидата.Контрагент) Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;

	Возврат Количество;

КонецФункции

&НаСервере
Функция ПолучитьДанныеДляПомощникаЭДОНаСервере()

	Кандидаты = РеквизитФормыВЗначение("КандидатыЭДО", Тип("ТаблицаЗначений"));
	Контрагенты = Новый Массив;
	ДанныеКонтрагентов = Новый ТаблицаЗначений;
	ДанныеКонтрагентов.Колонки.Добавить("Контрагент", Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	ДанныеКонтрагентов.Колонки.Добавить("ИНН", Новый ОписаниеТипов("Строка"));
	ДанныеКонтрагентов.Колонки.Добавить("КПП", Новый ОписаниеТипов("Строка"));
	ДанныеКонтрагентов.Колонки.Добавить("ИдентификаторУчастникаЭДО", Новый ОписаниеТипов("Строка"));
	ДанныеКонтрагентов.Колонки.Добавить("BoxId", Новый ОписаниеТипов("Строка"));

	УжеДобавлены = Новый Соответствие;

	Для Каждого СтрокаКандидата Из Кандидаты Цикл

		Если Не СтрокаКандидата.Отправлять Или Не ЗначениеЗаполнено(СтрокаКандидата.Контрагент) Тогда
			Продолжить;
		КонецЕсли;

		Если УжеДобавлены.Получить(СтрокаКандидата.Контрагент) <> Неопределено Тогда
			Продолжить;
		КонецЕсли;

		УжеДобавлены.Вставить(СтрокаКандидата.Контрагент, Истина);
		Контрагенты.Добавить(СтрокаКандидата.Контрагент);

		НоваяСтрока = ДанныеКонтрагентов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаКандидата);

	КонецЦикла;

	Возврат Новый Структура("Контрагенты,ДанныеКонтрагентов", Контрагенты, ДанныеКонтрагентов);

КонецФункции

#КонецОбласти
