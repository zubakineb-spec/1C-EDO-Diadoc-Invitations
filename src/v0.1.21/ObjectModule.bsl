// Возвращает сведения для регистрации обработки в подсистеме
// «Дополнительные отчеты и обработки».
//
// Возвращаемое значение:
//  Структура - параметры регистрации внешней обработки.
Функция СведенияОВнешнейОбработке() Экспорт

	РегистрационныеДанные = Новый Структура;
	РегистрационныеДанные.Вставить("Наименование", "Рассылка приглашений 1С-ЭДО по контрагентам Диадок");
	РегистрационныеДанные.Вставить("БезопасныйРежим", Ложь);
	РегистрационныеДанные.Вставить("Версия", "0.1.21");
	РегистрационныеДанные.Вставить("Вид", "ДополнительнаяОбработка");
	РегистрационныеДанные.Вставить(
		"Информация",
		"v0.1.21 на базе рабочей v0.1.20-r1. Для массовой роуминговой рассылки введен жесткий фильтр получателя: допускается только FnsParticipantId нативного Диадок с префиксом 2BM. Идентификаторы 2AE и других операторов исключаются до открытия типового помощника и повторно проверяются перед передачей. Сортировка, защита от дублей и разделение состояний роуминга сохранены.");

	Команды = Новый ТаблицаЗначений;
	Команды.Колонки.Добавить("Идентификатор");
	Команды.Колонки.Добавить("Представление");
	Команды.Колонки.Добавить("Модификатор");
	Команды.Колонки.Добавить("ПоказыватьОповещение");
	Команды.Колонки.Добавить("Использование");

	Команда = Команды.Добавить();
	Команда.Идентификатор = "ОткрытьФорму";
	Команда.Представление = "Рассылка приглашений 1С-ЭДО по Диадок";
	Команда.ПоказыватьОповещение = Ложь;
	Команда.Использование = "ОткрытиеФормы";

	РегистрационныеДанные.Вставить("Команды", Команды);

	Возврат РегистрационныеДанные;

КонецФункции
