			КоличествоНеСопоставленных = КоличествоНеСопоставленных + 1;
			Продолжить;
		КонецЕсли;

		Если Сопоставление.Код = "Неоднозначно" Тогда
			ДобавитьКандидата(ДанныеСтроки, Неопределено, Ложь, Сопоставление.Текст);
			КоличествоНеоднозначных = КоличествоНеоднозначных + 1;
			Продолжить;
		КонецЕсли;

		Контрагент = Сопоставление.Контрагент;
		Если Не ЗначениеЗаполнено(Контрагент) Тогда
			ДобавитьКандидата(ДанныеСтроки, Неопределено, Ложь, "Контрагент 1С не определен");
			КоличествоНеСопоставленных = КоличествоНеСопоставленных + 1;
			Продолжить;
		КонецЕсли;

		Если Сопоставление.Код = "ТребуетПроверки" Тогда
			ДобавитьКандидата(ДанныеСтроки, Контрагент, Ложь, Сопоставление.Текст);
			КоличествоТребуетПроверки = КоличествоТребуетПроверки + 1;
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(ДанныеСтроки.ИдентификаторУчастникаЭДО) Тогда
			ДобавитьКандидата(
				ДанныеСтроки,
				Контрагент,
				Ложь,
				"Диадок: действующий обмен; не получен FnsParticipantId — роуминговая отправка заблокирована");
			КоличествоБезИдентификатораЭДО = КоличествоБезИдентификатораЭДО + 1;
			Продолжить;
		КонецЕсли;

		Если Не ЭтоИдентификаторНативногоДиадок(ДанныеСтроки.ИдентификаторУчастникаЭДО) Тогда
			КодОператора = КодОператораИзИдЭДО(ДанныеСтроки.ИдентификаторУчастникаЭДО);
			Если КодОператора = "2AE" Тогда
				ТекстОператора = "ИдЭДО 2AE (Калуга Астрал): это не нативный абонент Диадок 2BM; роуминговая рассылка Диадок не применяется. Проверить прямую учетную запись 1С-ЭДО.";
			Иначе
				ТекстОператора = "ИдЭДО оператора " + КодОператора + ", а не Диадок 2BM — из роуминговой рассылки исключен";
			КонецЕсли;
			ДобавитьКандидата(
				ДанныеСтроки,
				Контрагент,
				Ложь,
				"Диадок: действующий обмен; " + ТекстОператора);
			КоличествоНе2BM = КоличествоНе2BM + 1;
			Продолжить;
		КонецЕсли;

		Состояние1СЭДО = ПолучитьСостояниеКонтрагентаВ1СЭДО(Объект.Организация, Контрагент);

		Если Состояние1СЭДО.Код = "Настроен" Тогда
			ДобавитьКандидата(
				ДанныеСтроки,
				Контрагент,
				Ложь,
				"Диадок: действующий обмен; роуминг 1С-ЭДО ↔ Диадок уже настроен — приглашение больше не требуется" +
				?(ПустаяСтрока(Состояние1СЭДО.Детали), "", " (" + Состояние1СЭДО.Детали + ")"));
			КоличествоУжеНастроено = КоличествоУжеНастроено + 1;
			Продолжить;
		КонецЕсли;

		Если Состояние1СЭДО.Код = "ПриглашениеЕсть" Тогда
			ДобавитьКандидата(
				ДанныеСтроки,
				Контрагент,
				Ложь,
				"Диадок: действующий обмен; роуминговое приглашение уже отправлено / ожидает принятия — повторно не отправлять" +
				?(ПустаяСтрока(Состояние1СЭДО.Детали), "", " (" + Состояние1СЭДО.Детали + ")"));
			КоличествоПриглашениеЕсть = КоличествоПриглашениеЕсть + 1;
			Продолжить;
		КонецЕсли;

		Если Не Состояние1СЭДО.Проверено Тогда
			ДобавитьКандидата(
				ДанныеСтроки,
				Контрагент,
				Ложь,
				"Диадок: действующий обмен; состояние 1С-ЭДО не удалось надежно проверить — отправка заблокирована");
			КоличествоТребуетПроверки = КоличествоТребуетПроверки + 1;
			Продолжить;
		КонецЕсли;

		ДобавитьКандидата(
			ДанныеСтроки,
			Контрагент,
			Истина,
			"требуется роуминговое приглашение");
		КоличествоГотовых = КоличествоГотовых + 1;

	КонецЦикла;

	// v0.1.19: после заполнения выводим контрагентов по алфавиту.
	// Для сопоставленных строк приоритетно используется наименование карточки 1С,
	// для несопоставленных — наименование, полученное из Диадока.
	СортироватьКандидатовПоНаименованию();

	ТекстBoxId = ?(ПустаяСтрока(BoxIdОрганизации), "не определен", BoxIdОрганизации);
	Возврат СтрШаблон(
		"DRY-RUN. Ящик Диадок: %1; партнеров — %2; требуется роуминговое приглашение 2BM — %3; роуминг уже настроен — %4; "
		+ "приглашение уже отправлено / ожидает принятия — %5; не сопоставлено — %6; неоднозначно — %7; ручная проверка — %8; без FnsParticipantId — %9; не 2BM — %10. Ничего не отправлено."
		+ Символы.ПС + "Статус «требуется роуминговое приглашение» присваивается только нативным абонентам Диадок с ИдЭДО 2BM.",
		ТекстBoxId,
		КоличествоПартнеров,
		КоличествоГотовых,
		КоличествоУжеНастроено,
		КоличествоПриглашениеЕсть,
		КоличествоНеСопоставленных,
		КоличествоНеоднозначных,
		КоличествоТребуетПроверки,
		КоличествоБезИдентификатораЭДО,
		КоличествоНе2BM);

КонецФункции

&НаСервере
Функция НайтиСопоставлениеКонтрагента1С(ИНН, КПП, НаименованиеДиадок)

	ИНН = СокрЛП(Строка(ИНН));
