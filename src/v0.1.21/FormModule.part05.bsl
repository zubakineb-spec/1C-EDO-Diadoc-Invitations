	Точные = НайтиКонтрагентов1С(ИНН, КПП, Ложь);
	Если Точные.Количество() = 1 Тогда
		Возврат Новый Структура("Код,Контрагент,Текст", "Точно", Точные[0].Ссылка,
			"Сопоставлен точно по ИНН/КПП");
	КонецЕсли;

	Если Точные.Количество() > 1 Тогда
		ПоИмени = ВыбратьЕдинственногоПоНаименованию(Точные, НаименованиеДиадок);
		Если ЗначениеЗаполнено(ПоИмени) Тогда
			Возврат Новый Структура("Код,Контрагент,Текст", "Точно", ПоИмени,
				"Несколько дублей по ИНН/КПП; выбран единственный по совпадению наименования");
		КонецЕсли;
		Возврат Новый Структура("Код,Контрагент,Текст", "Неоднозначно", Неопределено,
			"Несколько контрагентов 1С с тем же ИНН/КПП — требуется ручной выбор");
	КонецЕсли;

	// 2. Для ИП/физлиц КПП в Диадоке обычно пустой: допустимо уникальное совпадение по ИНН.
	ПоИНН = НайтиКонтрагентов1С(ИНН, "", Истина);
	Если ПустаяСтрока(КПП) И ПоИНН.Количество() = 1 Тогда
		Возврат Новый Структура("Код,Контрагент,Текст", "Точно", ПоИНН[0].Ссылка,
			"Сопоставлен по уникальному ИНН (КПП отсутствует в Диадоке)");
	КонецЕсли;

	Если ПоИНН.Количество() = 0 Тогда
		Возврат Новый Структура("Код,Контрагент,Текст", "НеНайден", Неопределено,
			"Не сопоставлен с контрагентом 1С: совпадение по ИНН/КПП не найдено");
	КонецЕсли;

	Если ПоИНН.Количество() > 1 Тогда
		ПоИмени = ВыбратьЕдинственногоПоНаименованию(ПоИНН, НаименованиеДиадок);
		Если ПустаяСтрока(КПП) И ЗначениеЗаполнено(ПоИмени) Тогда
			Возврат Новый Структура("Код,Контрагент,Текст", "Точно", ПоИмени,
				"Несколько записей по ИНН; выбран единственный по наименованию");
		КонецЕсли;
		Возврат Новый Структура("Код,Контрагент,Текст", "Неоднозначно", Неопределено,
			"По ИНН найдено несколько контрагентов/обособленных подразделений — требуется ручной выбор");
	КонецЕсли;

	// Если Диадок передал КПП, а единственная карточка 1С имеет другой/пустой КПП,
	// не подменяем обособленное подразделение головной организацией автоматически.
	Возврат Новый Структура("Код,Контрагент,Текст", "ТребуетПроверки", ПоИНН[0].Ссылка,
		"ИНН совпал, но КПП отличается или не заполнен в 1С — требуется ручная проверка головной/обособленной организации");

КонецФункции

&НаСервере
Функция НайтиКонтрагентов1С(ИНН, КПП, ТолькоИНН)

	Результат = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Контрагенты.Ссылка КАК Ссылка,
		|	Контрагенты.Наименование КАК Наименование,
		|	Контрагенты.ИНН КАК ИНН,
		|	Контрагенты.КПП КАК КПП
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	НЕ Контрагенты.ПометкаУдаления
		|	И Контрагенты.ИНН = &ИНН";
	Если Не ТолькоИНН Тогда
		Запрос.Текст = Запрос.Текст + Символы.ПС + "	И Контрагенты.КПП = &КПП";
	КонецЕсли;
	Запрос.УстановитьПараметр("ИНН", ИНН);
	Запрос.УстановитьПараметр("КПП", КПП);

	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Результат.Добавить(Новый Структура(
			"Ссылка,Наименование,ИНН,КПП",
			Выборка.Ссылка,
			Выборка.Наименование,
			Выборка.ИНН,
			Выборка.КПП));
	КонецЦикла;
	Возврат Результат;

КонецФункции

&НаСервере
Функция ВыбратьЕдинственногоПоНаименованию(Кандидаты, НаименованиеДиадок)

	Эталон = НормализоватьНаименованиеКонтрагента(НаименованиеДиадок);
	Если ПустаяСтрока(Эталон) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Найден = Неопределено;
	Количество = 0;
	Для Каждого Кандидат Из Кандидаты Цикл
		Если НормализоватьНаименованиеКонтрагента(Кандидат.Наименование) = Эталон Тогда
			Найден = Кандидат.Ссылка;
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат ?(Количество = 1, Найден, Неопределено);

КонецФункции

&НаСервере
Функция НормализоватьНаименованиеКонтрагента(Значение)

	Текст = ВРег(СокрЛП(Строка(Значение)));
	Для Каждого Фрагмент Из СтрРазделить("ООО|АО|ПАО|ЗАО|ОАО|ИП|""|«|»|.|,|-|_| ", "|") Цикл
		Текст = СтрЗаменить(Текст, Фрагмент, "");
	КонецЦикла;
	Возврат Текст;

КонецФункции

&НаСервере
Функция ПолучитьСостояниеКонтрагентаВ1СЭДО(Организация, Контрагент)

	Результат = Новый Структура(
		"Проверено,Код,Источник,Детали",
		Ложь,
		"НеПроверено",
		"",
		"");

	// Сначала ищем действующую настройку обмена. Набор регистров различается
	// между версиями БЭД/1С-ЭДО, поэтому обращаемся только к реально существующим метаданным.
	РегистрыНастроек = Новый Массив;
	РегистрыНастроек.Добавить("НастройкиОбменаЭлектроннымиДокументами");
