&НаСервере
Функция КодОператораИзИдЭДО(ИдЭДО)

	СтрокаИд = ВРег(СокрЛП(Строка(ИдЭДО)));
	Если СтрДлина(СтрокаИд) < 3 Тогда
		Возврат "";
	КонецЕсли;
	Возврат Лев(СтрокаИд, 3);

КонецФункции

&НаСервере
Функция ЭтоИдентификаторНативногоДиадок(ИдЭДО)
	Возврат КодОператораИзИдЭДО(ИдЭДО) = "2BM";
КонецФункции

&НаСервере
Функция СтатусТребуетРоуминговогоПриглашения(СтрокаКандидата)
	Возврат НРег(СокрЛП(Строка(СтрокаКандидата.Результат))) = "требуется роуминговое приглашение";
КонецФункции

&НаСервере
Функция ПолучитьКоличествоВыбранныхНаСервере()
	Количество = 0;
	Для Каждого СтрокаКандидата Из Объект.КандидатыЭДО Цикл
		Если СтрокаКандидата.Отправлять
			И СтатусТребуетРоуминговогоПриглашения(СтрокаКандидата)
			И ЗначениеЗаполнено(СтрокаКандидата.Контрагент) Тогда
			Количество = Количество + 1;
		КонецЕсли;
	КонецЦикла;
	Возврат Количество;
КонецФункции

&НаСервере
Функция ПроверитьКандидатовПередОтправкойНаСервере()

	КПередаче = 0;
	СнятоКакДубль = 0;
	СнятоНеПроверено = 0;
	СнятоНеРоуминг = 0;
	СнятоНе2BM = 0;

	Для Каждого СтрокаКандидата Из Объект.КандидатыЭДО Цикл
		Если Не СтрокаКандидата.Отправлять Тогда
			Продолжить;
		КонецЕсли;

		// Жесткий бизнес-фильтр. Флаг пользователя сам по себе не дает права на отправку.
		// Разрешен только статус, присвоенный dry-run после подтвержденного действующего обмена в Диадок.
		Если Не СтатусТребуетРоуминговогоПриглашения(СтрокаКандидата) Тогда
			СтрокаКандидата.Отправлять = Ложь;
			СнятоНеРоуминг = СнятоНеРоуминг + 1;
			Продолжить;
		КонецЕсли;

		Если Не ЗначениеЗаполнено(СтрокаКандидата.Контрагент)
			Или Не ЗначениеЗаполнено(СтрокаКандидата.ИдентификаторУчастникаЭДО) Тогда
			СтрокаКандидата.Отправлять = Ложь;
			СтрокаКандидата.Результат = "Контроль перед отправкой: нет точного FnsParticipantId — строка снята";
			СнятоНеПроверено = СнятоНеПроверено + 1;
			Продолжить;
		КонецЕсли;

		Если Не ЭтоИдентификаторНативногоДиадок(СтрокаКандидата.ИдентификаторУчастникаЭДО) Тогда
			СтрокаКандидата.Отправлять = Ложь;
			СтрокаКандидата.Результат = "Контроль перед отправкой: целевой ИдЭДО " + Строка(СтрокаКандидата.ИдентификаторУчастникаЭДО)
				+ " не принадлежит Диадок (ожидается 2BM) — отправка запрещена";
			СнятоНе2BM = СнятоНе2BM + 1;
			Продолжить;
		КонецЕсли;

		Состояние = ПолучитьСостояниеКонтрагентаВ1СЭДО(Объект.Организация, СтрокаКандидата.Контрагент);
		Если Состояние.Код = "Настроен" Тогда
			СтрокаКандидата.Отправлять = Ложь;
			СтрокаКандидата.Результат = "Контроль перед отправкой: роуминг 1С-ЭДО ↔ Диадок уже настроен — повторная отправка запрещена";
			СнятоКакДубль = СнятоКакДубль + 1;
			Продолжить;
		КонецЕсли;

		Если Состояние.Код = "ПриглашениеЕсть" Тогда
			СтрокаКандидата.Отправлять = Ложь;
			СтрокаКандидата.Результат = "Контроль перед отправкой: роуминговое приглашение уже отправлено / ожидает принятия — повторная отправка запрещена";
			СнятоКакДубль = СнятоКакДубль + 1;
			Продолжить;
		КонецЕсли;

		Если Не Состояние.Проверено Тогда
			СтрокаКандидата.Отправлять = Ложь;
			СтрокаКандидата.Результат = "Контроль перед отправкой: состояние 1С-ЭДО не подтверждено — отправка заблокирована";
			СнятоНеПроверено = СнятоНеПроверено + 1;
			Продолжить;
		КонецЕсли;

		// Успешная повторная проверка не меняет статус: он остается точным разрешающим маркером.
		КПередаче = КПередаче + 1;
	КонецЦикла;

	Текст = СтрШаблон(
		"к передаче роуминговых приглашений 2BM — %1; снято как дубль — %2; заблокировано из-за неполной проверки — %3; снято как не-роуминг — %4; исключено как не 2BM — %5",
		КПередаче, СнятоКакДубль, СнятоНеПроверено, СнятоНеРоуминг, СнятоНе2BM);
	Возврат Новый Структура("КПередаче,СнятоКакДубль,СнятоНеПроверено,СнятоНеРоуминг,СнятоНе2BM,Текст",
		КПередаче, СнятоКакДубль, СнятоНеПроверено, СнятоНеРоуминг, СнятоНе2BM, Текст);

КонецФункции

&НаСервере
Функция ПолучитьДанныеДляПомощникаЭДОНаСервере()

	Контрагенты = Новый Массив;
	ИдентификаторыУчастниковЭДО = Новый Массив;
	BoxIds = Новый Массив;

	// Между сервером управляемой формы и клиентом передаем только сериализуемые
	// массивы/структуры. ТаблицаЗначений здесь намеренно не используется.
	ДанныеКонтрагентов = Новый Массив;

	УжеДобавлены = Новый Соответствие;
	Для Каждого СтрокаКандидата Из Объект.КандидатыЭДО Цикл
		Если Не СтрокаКандидата.Отправлять
			Или Не СтатусТребуетРоуминговогоПриглашения(СтрокаКандидата)
			Или Не ЗначениеЗаполнено(СтрокаКандидата.Контрагент)
			Или Не ЭтоИдентификаторНативногоДиадок(СтрокаКандидата.ИдентификаторУчастникаЭДО) Тогда
			Продолжить;
		КонецЕсли;
