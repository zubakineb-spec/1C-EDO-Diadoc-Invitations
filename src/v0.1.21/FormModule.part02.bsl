	Результат = Новый Массив;
	Если МассивCounteragents = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	Для Каждого ПорцияCounteragents Из МассивCounteragents Цикл
		Если ПорцияCounteragents = Неопределено Тогда
			Продолжить;
		КонецЕсли;

		Для Каждого Counteragent Из ПорцияCounteragents Цикл
			ДанныеКонтрагента = ПростойКонтрагентИзCounteragentДиадок(Counteragent);
			Если ДанныеКонтрагента <> Неопределено Тогда
				Результат.Добавить(ДанныеКонтрагента);
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ПростойКонтрагентИзCounteragentДиадок(Counteragent)

	Попытка
		Organization = Counteragent.Organization;
	Исключение
		Возврат Неопределено;
	КонецПопытки;

	Если Organization = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;

	BoxId = "";
	Попытка
		Если Organization.Boxes.Количество() > 0 Тогда
			BoxId = Organization.Boxes[0].BoxId;
		КонецЕсли;
	Исключение
	КонецПопытки;

	ИНН = "";
	КПП = "";
	OrgId = "";
	ИдентификаторУчастникаЭДО = "";
	ПолноеНаименование = "";
	КраткоеНаименование = "";
	Статус = "";

	Попытка
		ИНН = Organization.Inn;
	Исключение
	КонецПопытки;
	Попытка
		КПП = Organization.Kpp;
	Исключение
	КонецПопытки;
	Попытка
		OrgId = Organization.OrgId;
	Исключение
	КонецПопытки;
	Попытка
		ИдентификаторУчастникаЭДО = Organization.FnsParticipantId;
	Исключение
	КонецПопытки;
	Попытка
		ПолноеНаименование = Organization.FullName;
	Исключение
	КонецПопытки;
	Попытка
		КраткоеНаименование = Organization.ShortName;
	Исключение
	КонецПопытки;
	Попытка
		Статус = Counteragent.CurrentStatus;
	Исключение
	КонецПопытки;
	Если ПустаяСтрока(Статус) Тогда
		Попытка
			Статус = Counteragent.CounteragentStatus;
		Исключение
		КонецПопытки;
	КонецЕсли;

	Наименование = ?(ПустаяСтрока(КраткоеНаименование), ПолноеНаименование, КраткоеНаименование);

	ДатаЛиквидации = Неопределено;
	Попытка
		Если ТипЗнч(Organization.LiquidationDate) = Тип("Дата") Тогда
			ДатаЛиквидации = Organization.LiquidationDate;
		КонецЕсли;
	Исключение
	КонецПопытки;

	Результат = Новый Структура;
	Результат.Вставить("ID", BoxId);
	Результат.Вставить("OrgId", OrgId);
	Результат.Вставить("Наименование", Наименование);
	Результат.Вставить("ИНН", ИНН);
	Результат.Вставить("КПП", КПП);
	Результат.Вставить("ИдентификаторУчастникаЭДО", ИдентификаторУчастникаЭДО);
	Результат.Вставить("Статус", Статус);
	Результат.Вставить("РеквизитыСвязанныхСправочников", Новый Массив);
	Результат.Вставить("ДатаЛиквидации", ДатаЛиквидации);

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ПолучитьАвторизованныйBoxIdДляОрганизации(ПлатформаДиадок)

	СтрокиКонтекста = ПлатформаДиадок.МетодСервераБезКонтекста(
		Истина,
		"Модуль_Ядро().КонтекстСеанса_СтрокиКонтекста");

	Если СтрокиКонтекста = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Для Каждого СтрокаКонтекста Из СтрокиКонтекста Цикл

		BoxId = ПолучитьBoxIdИзСтрокиКонтекстаДиадок(СтрокаКонтекста);
