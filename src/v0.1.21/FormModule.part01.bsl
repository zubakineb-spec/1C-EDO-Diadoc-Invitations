			ПараметрыФормы,
			ЭтаФорма);

		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить(
			"ОбщийКонтекстКлиентСервер",
			ДанныеСеанса.ОбщийКонтекстКлиентСервер);

		// Используем фабрику описаний оповещений самого Диадока. Это важно для
		// совместимости его платформенного слоя с конкретной версией 1С.
		Оповещение = мМодульПлатформаДиадок.НовыйОписаниеОповещения(
			"ПослеНачалаСеансаДиадок",
			ЭтаФорма,
			ДополнительныеПараметры);

		// Штатный Сеанс_Начать до вызова нашего обработчика сам устанавливает
		// полученный контекст на сервере Диадока.
		мМодульПлатформаДиадок.Сеанс_Начать(Оповещение);
	Исключение
		Предупреждение("Не удалось выполнить штатную авторизацию Контур.Диадок из обработки." + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ПослеНачалаСеансаДиадок(НовыйКонтекст, ДополнительныеПараметры) Экспорт

	Если Не ЗначениеЗаполнено(НовыйКонтекст) Тогда
		Предупреждение("Авторизация в Контур.Диадок не завершена. Получение контрагентов отменено.");
		Возврат;
	КонецЕсли;

	Если мМодульПлатформаДиадок = Неопределено Тогда
		Предупреждение("Не сохранен экземпляр штатной платформенной формы Контур.Диадок. Повторите получение.");
		Возврат;
	КонецЕсли;

	Попытка
		// В Контур.Диадок 4.68.0 Сеанс_Начать() до callback уже выполняет
		// инициализацию КонтекстСеанса ядра. Как штатная главная форма,
		// передаем тот же контекст в общий серверный модуль КонтурДиадокСервер.
		мМодульПлатформаДиадок.ПараметрыСеансаОбновитьКонтекст(НовыйКонтекст);

		ДанныеДиадок = ПолучитьПартнеровЧерезШтатнуюПлатформуДиадок(мМодульПлатформаДиадок);
	Исключение
		Предупреждение(
			"Контур.Диадок авторизован, но получить партнеров через его штатный серверный контекст не удалось."
			+ Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Попытка
		Итог = ЗаполнитьКандидатовИзСпискаДиадокНаСервере(
			ДанныеДиадок.СписокДиадок,
			ДанныеДиадок.СтатусПартнера,
			ДанныеДиадок.BoxIdОрганизации);
	Исключение
		Предупреждение("Диадок вернул список партнеров, но не удалось заполнить кандидатов 1С-ЭДО." + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	Элементы.ФормаСоздатьДокументы.Доступность = ПолучитьКоличествоВыбранныхНаСервере() > 0;
	Сообщить(Итог);

КонецПроцедуры

&НаКлиенте
Функция ПолучитьПартнеровЧерезШтатнуюПлатформуДиадок(ПлатформаДиадок)

	// v0.1.15: Контур.Диадок 4.68.0 возвращает ТаблицаЗначений из
	// Контрагенты_ТаблицаКонтрактовПоCounteragents(). ТаблицаЗначений не может
	// быть возвращена через МетодСервераБезКонтекста в клиентский контекст.
	// Поэтому с сервера Диадок забираем только сериализуемый МассивCounteragents,
	// а в простой массив структур преобразуем уже на клиенте.
	BoxIdОрганизации = ПолучитьАвторизованныйBoxIdДляОрганизации(ПлатформаДиадок);
	Если ПустаяСтрока(BoxIdОрганизации) Тогда
		ВызватьИсключение
			"В текущем авторизованном контексте Контур.Диадок не найден ящик, "
			+ "сопоставленный с выбранной организацией 1С.";
	КонецЕсли;

	СтрокаКонтекста = ПлатформаДиадок.МетодСервераБезКонтекста(
		Истина,
		"Модуль_Ядро().КонтекстСеанса_СтрокаКонтекста",
		BoxIdОрганизации);

	Если СтрокаКонтекста = Неопределено Тогда
		ВызватьИсключение
			"В контексте авторизованной сессии Диадок отсутствует строка BoxId "
			+ BoxIdОрганизации + ".";
	КонецЕсли;

	ДанныеОрганизации = ПлатформаДиадок.МетодСервераБезКонтекста(
		Истина,
		"Модуль_Ядро().Контракт_ОрганизацияЭДО");
	ДанныеОрганизации.ID = BoxIdОрганизации;
	Попытка
		ДанныеОрганизации.OrgId = СтрокаКонтекста.OrgId;
	Исключение
	КонецПопытки;

	// В фактическом CFE 4.68.0 значение ПартнерскиеОтношения равно IsMyCounteragent.
	СтатусПартнера = "IsMyCounteragent";

	МассивCounteragents = ПлатформаДиадок.МетодСервераБезКонтекста(
		Истина,
		"Модуль_Ядро().Контрагенты_МассивCounteragents",
		ДанныеОрганизации,
		СтатусПартнера);

	СписокДиадок = ПреобразоватьCounteragentsВСписокДиадок(МассивCounteragents);

	Возврат Новый Структура(
		"СписокДиадок,СтатусПартнера,BoxIdОрганизации",
		СписокДиадок,
		СтатусПартнера,
		BoxIdОрганизации);

КонецФункции

&НаКлиенте
Функция ПреобразоватьCounteragentsВСписокДиадок(МассивCounteragents)

