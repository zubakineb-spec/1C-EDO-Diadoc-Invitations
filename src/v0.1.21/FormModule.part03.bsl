		Если ПустаяСтрока(BoxId) Тогда
			Продолжить;
		КонецЕсли;

		Идентификаторы = ПлатформаДиадок.МетодСервераБезКонтекста(
			Истина,
			"Модуль_Ядро().Новый_ИдентификаторыСправочника",
			Неопределено,
			BoxId);

		СопоставленнаяОрганизация = Неопределено;
		Попытка
			СопоставленнаяОрганизация = ПлатформаДиадок.МетодСервераБезКонтекста(
				Истина,
				"Модуль_Ядро().ХранениеДанных_СопоставленнаяОрганизацияВ1С",
				Идентификаторы);
		Исключение
		КонецПопытки;

		Если ЗначениеЗаполнено(СопоставленнаяОрганизация)
			И СопоставленнаяОрганизация = Объект.Организация Тогда
			Возврат BoxId;
		КонецЕсли;

	КонецЦикла;

	Попытка
		Организации1С = Новый Массив;
		Организации1С.Добавить(Объект.Организация);
		УчастникиДО = ПлатформаДиадок.МетодСервераБезКонтекста(
			Истина,
			"Модуль_Ядро().Организации_ДанныеУчастниковДОПоОрганизациям1С",
			Организации1С);

		Для Каждого УчастникДО Из УчастникиДО Цикл
			BoxIdУчастника = "";
			Попытка
				BoxIdУчастника = УчастникДО.BoxId;
			Исключение
				Попытка
					BoxIdУчастника = УчастникДО.BoxID;
				Исключение
				КонецПопытки;
			КонецПопытки;

			Если ПустаяСтрока(BoxIdУчастника) Тогда
				Продолжить;
			КонецЕсли;

			Для Каждого СтрокаКонтекста Из СтрокиКонтекста Цикл
				Если ПолучитьBoxIdИзСтрокиКонтекстаДиадок(СтрокаКонтекста) = BoxIdУчастника Тогда
					Возврат BoxIdУчастника;
				КонецЕсли;
			КонецЦикла;
		КонецЦикла;
	Исключение
	КонецПопытки;

	Возврат "";

КонецФункции

&НаКлиенте
Функция ПолучитьBoxIdИзСтрокиКонтекстаДиадок(СтрокаКонтекста)

	BoxId = "";
	Попытка
		BoxId = СтрокаКонтекста.Ключ;
	Исключение
		Попытка
			BoxId = СтрокаКонтекста.Значение.BoxId;
		Исключение
		КонецПопытки;
	КонецПопытки;
	Возврат BoxId;

КонецФункции

&НаСервере
Функция ПодготовитьСеансДиадокНаСервере()

	ДиадокОбъект = ПолучитьОбъектМодуляДиадок();
	ДиадокОбъект.ИнициализироватьОбщийКонтекст();

	Результат = Новый Структура;
	Результат.Вставить("ПутьКФормам", ДиадокОбъект.Метаданные().ПолноеИмя() + ".Форма.");
	Результат.Вставить("ОбщийКонтекстКлиентСервер", ДиадокОбъект.ОбщийКонтекстКлиентСервер);
	Возврат Результат;

КонецФункции

&НаСервере
Функция ЗаполнитьКандидатовИзСпискаДиадокНаСервере(СписокДиадок, СтатусПартнера, BoxIdОрганизации)

	Объект.КандидатыЭДО.Очистить();

	КоличествоПартнеров = 0;
	КоличествоГотовых = 0;
	КоличествоНеСопоставленных = 0;
	КоличествоНеоднозначных = 0;
	КоличествоУжеНастроено = 0;
	КоличествоПриглашениеЕсть = 0;
	КоличествоБезИдентификатораЭДО = 0;
	КоличествоТребуетПроверки = 0;
	КоличествоНе2BM = 0;

	Для Каждого СтрокаДиадок Из СписокДиадок Цикл

		ДанныеСтроки = Новый Структура(
			"ID,Наименование,ИНН,КПП,ИдентификаторУчастникаЭДО,Статус,РеквизитыСвязанныхСправочников,ДатаЛиквидации");
		ЗаполнитьЗначенияСвойств(ДанныеСтроки, СтрокаДиадок);
		КоличествоПартнеров = КоличествоПартнеров + 1;

		Если ЗначениеЗаполнено(ДанныеСтроки.ДатаЛиквидации) Тогда
			ДобавитьКандидата(ДанныеСтроки, Неопределено, Ложь, "Диадок: организация ликвидирована");
			Продолжить;
		КонецЕсли;

		Сопоставление = НайтиСопоставлениеКонтрагента1С(
			ДанныеСтроки.ИНН,
			ДанныеСтроки.КПП,
			ДанныеСтроки.Наименование);

		Если Сопоставление.Код = "НеНайден" Тогда
			ДобавитьКандидата(ДанныеСтроки, Неопределено, Ложь, Сопоставление.Текст);
