	РегистрыНастроек.Добавить("НастройкиОбменаЭДО");
	РегистрыНастроек.Добавить("НастройкиЭлектронногоДокументооборота");
	РегистрыНастроек.Добавить("НастройкиЭДО");

	Для Каждого ИмяРегистра Из РегистрыНастроек Цикл
		Проверка = НайтиЗаписьЭДОПоОрганизацииКонтрагенту(ИмяРегистра, Организация, Контрагент);
		Если Проверка.Проверено Тогда
			Результат.Проверено = Истина;
		КонецЕсли;
		Если Проверка.ЕстьЗапись Тогда
			Результат.Код = "Настроен";
			Результат.Источник = "РегистрСведений." + ИмяРегистра;
			Результат.Детали = Проверка.Детали;
			Возврат Результат;
		КонецЕсли;
	КонецЦикла;

	// Затем отдельно проверяем журнал приглашений. Любая существующая запись
	// блокирует повторную массовую отправку; ее фактический статус выводится пользователю.
	ПроверкаПриглашения = НайтиЗаписьЭДОПоОрганизацииКонтрагенту(
		"ПриглашенияКОбменуЭлектроннымиДокументами",
		Организация,
		Контрагент);
	Если ПроверкаПриглашения.Проверено Тогда
		Результат.Проверено = Истина;
	КонецЕсли;
	Если ПроверкаПриглашения.ЕстьЗапись Тогда
		Результат.Код = ?(СтатусОзначаетНастроенныйОбмен(ПроверкаПриглашения.Детали), "Настроен", "ПриглашениеЕсть");
		Результат.Источник = "РегистрСведений.ПриглашенияКОбменуЭлектроннымиДокументами";
		Результат.Детали = ПроверкаПриглашения.Детали;
		Возврат Результат;
	КонецЕсли;

	Если Результат.Проверено Тогда
		Результат.Код = "Нет";
	КонецЕсли;
	Возврат Результат;

КонецФункции

&НаСервере
Функция СтатусОзначаетНастроенныйОбмен(Детали)

	Текст = ВРег(Строка(Детали));
	Возврат СтрНайти(Текст, "ПРИНЯТ") > 0
		Или СтрНайти(Текст, "ACCEPT") > 0
		Или СтрНайти(Текст, "НАСТРО") > 0
		Или СтрНайти(Текст, "УСТАНОВЛ") > 0
		Или СтрНайти(Текст, "ДЕЙСТВУЮЩ") > 0;

КонецФункции

&НаСервере
Функция НайтиЗаписьЭДОПоОрганизацииКонтрагенту(ИмяРегистра, Организация, Контрагент)

	Результат = Новый Структура("Проверено,ЕстьЗапись,Детали", Ложь, Ложь, "");
	МетаданныеРегистра = Метаданные.РегистрыСведений.Найти(ИмяРегистра);
	Если МетаданныеРегистра = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;

	ИменаОрганизации = Новый Массив;
	ИменаОрганизации.Добавить("Организация");
	ИменаОрганизации.Добавить("ОрганизацияОтправитель");
	ИменаОрганизации.Добавить("ВладелецУчетнойЗаписи");
	ИмяПоляОрганизации = НайтиПолеРегистраЭДО(МетаданныеРегистра, ИменаОрганизации);

	ИменаКонтрагента = Новый Массив;
	ИменаКонтрагента.Добавить("Контрагент");
	ИменаКонтрагента.Добавить("КонтрагентПолучатель");
	ИменаКонтрагента.Добавить("Получатель");
	ИмяПоляКонтрагента = НайтиПолеРегистраЭДО(МетаданныеРегистра, ИменаКонтрагента);

	Если ПустаяСтрока(ИмяПоляОрганизации) Или ПустаяСтрока(ИмяПоляКонтрагента) Тогда
		Возврат Результат;
	КонецЕсли;

	ИменаСтатуса = Новый Массив;
	ИменаСтатуса.Добавить("Состояние");
	ИменаСтатуса.Добавить("Статус");
	ИменаСтатуса.Добавить("СостояниеПриглашения");
	ИменаСтатуса.Добавить("СтатусПриглашения");
	ИмяПоляСтатуса = НайтиПолеРегистраЭДО(МетаданныеРегистра, ИменаСтатуса);

	ПолеСтатусаЗапроса = ?(ПустаяСтрока(ИмяПоляСтатуса), "", "," + Символы.ПС + "	НастройкаЭДО." + ИмяПоляСтатуса + " КАК СтатусЭДО");

	Попытка
		Запрос = Новый Запрос;
		Запрос.Текст =
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	1 КАК ЕстьЗапись" + ПолеСтатусаЗапроса + "
			|ИЗ
			|	РегистрСведений." + ИмяРегистра + " КАК НастройкаЭДО
			|ГДЕ
			|	НастройкаЭДО." + ИмяПоляОрганизации + " = &Организация
			|	И НастройкаЭДО." + ИмяПоляКонтрагента + " = &Контрагент";
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Результат.Проверено = Истина;
		Выборка = Запрос.Выполнить().Выбрать();
		Если Выборка.Следующий() Тогда
			Результат.ЕстьЗапись = Истина;
			Если Не ПустаяСтрока(ИмяПоляСтатуса) Тогда
				Попытка
					Результат.Детали = "статус: " + Строка(Выборка.СтатусЭДО);
				Исключение
				КонецПопытки;
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Метаданные найдены, но конкретный релиз может иметь особенности типа поля.
		// Не выдаем ложное заключение об отсутствии настройки.
		Результат.Проверено = Ложь;
	КонецПопытки;

	Возврат Результат;

КонецФункции

&НаСервере
Функция НайтиПолеРегистраЭДО(МетаданныеРегистра, ВозможныеИмена)

	Для Каждого ИмяПоля Из ВозможныеИмена Цикл
		Попытка
			ПолеМетаданных = МетаданныеРегистра.Измерения.Найти(ИмяПоля);
