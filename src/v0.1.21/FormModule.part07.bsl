			Если ПолеМетаданных <> Неопределено Тогда
				Возврат ПолеМетаданных.Имя;
			КонецЕсли;
		Исключение
		КонецПопытки;

		Попытка
			ПолеМетаданных = МетаданныеРегистра.Ресурсы.Найти(ИмяПоля);
			Если ПолеМетаданных <> Неопределено Тогда
				Возврат ПолеМетаданных.Имя;
			КонецЕсли;
		Исключение
		КонецПопытки;

		Попытка
			ПолеМетаданных = МетаданныеРегистра.Реквизиты.Найти(ИмяПоля);
			Если ПолеМетаданных <> Неопределено Тогда
				Возврат ПолеМетаданных.Имя;
			КонецЕсли;
		Исключение
		КонецПопытки;
	КонецЦикла;

	Возврат "";

КонецФункции

&НаСервере
Функция ПолучитьОбъектМодуляДиадок()

	Попытка
		Возврат ВнешниеОбработки.Создать("КонтурЭДО");
	Исключение
		ВызватьИсключение
			"Подключенный модуль Контур.Диадок (КонтурЭДО) не найден. "
			+ "Откройте/подключите штатный модуль Диадок в базе и повторите операцию.";
	КонецПопытки;

КонецФункции

&НаСервере
Процедура СортироватьКандидатовПоНаименованию()

	Если Объект.КандидатыЭДО.Количество() < 2 Тогда
		Возврат;
	КонецЕсли;

	ТаблицаСортировки = Новый ТаблицаЗначений;
	ТаблицаСортировки.Колонки.Добавить("КлючСортировки");
	ТаблицаСортировки.Колонки.Добавить("Отправлять");
	ТаблицаСортировки.Колонки.Добавить("Контрагент");
	ТаблицаСортировки.Колонки.Добавить("НаименованиеДиадок");
	ТаблицаСортировки.Колонки.Добавить("ИНН");
	ТаблицаСортировки.Колонки.Добавить("КПП");
	ТаблицаСортировки.Колонки.Добавить("BoxId");
	ТаблицаСортировки.Колонки.Добавить("ИдентификаторУчастникаЭДО");
	ТаблицаСортировки.Колонки.Добавить("Результат");

	Для Каждого СтрокаКандидата Из Объект.КандидатыЭДО Цикл

		НаименованиеДляСортировки = "";
		Если ЗначениеЗаполнено(СтрокаКандидата.Контрагент) Тогда
			Попытка
				НаименованиеДляСортировки = СокрЛП(Строка(СтрокаКандидата.Контрагент.Наименование));
			Исключение
				НаименованиеДляСортировки = СокрЛП(Строка(СтрокаКандидата.Контрагент));
			КонецПопытки;
		КонецЕсли;

		Если ПустаяСтрока(НаименованиеДляСортировки) Тогда
			НаименованиеДляСортировки = СокрЛП(Строка(СтрокаКандидата.НаименованиеДиадок));
		КонецЕсли;

		СтрокаСортировки = ТаблицаСортировки.Добавить();
		СтрокаСортировки.КлючСортировки = НРег(НаименованиеДляСортировки) + "|"
			+ НРег(СокрЛП(Строка(СтрокаКандидата.НаименованиеДиадок))) + "|"
			+ СокрЛП(Строка(СтрокаКандидата.ИНН)) + "|"
			+ СокрЛП(Строка(СтрокаКандидата.КПП));
		СтрокаСортировки.Отправлять = СтрокаКандидата.Отправлять;
		СтрокаСортировки.Контрагент = СтрокаКандидата.Контрагент;
		СтрокаСортировки.НаименованиеДиадок = СтрокаКандидата.НаименованиеДиадок;
		СтрокаСортировки.ИНН = СтрокаКандидата.ИНН;
		СтрокаСортировки.КПП = СтрокаКандидата.КПП;
		СтрокаСортировки.BoxId = СтрокаКандидата.BoxId;
		СтрокаСортировки.ИдентификаторУчастникаЭДО = СтрокаКандидата.ИдентификаторУчастникаЭДО;
		СтрокаСортировки.Результат = СтрокаКандидата.Результат;

	КонецЦикла;

	ТаблицаСортировки.Сортировать("КлючСортировки Возр");
	Объект.КандидатыЭДО.Очистить();

	Для Каждого СтрокаСортировки Из ТаблицаСортировки Цикл
		НоваяСтрока = Объект.КандидатыЭДО.Добавить();
		НоваяСтрока.Отправлять = СтрокаСортировки.Отправлять;
		НоваяСтрока.Контрагент = СтрокаСортировки.Контрагент;
		НоваяСтрока.НаименованиеДиадок = СтрокаСортировки.НаименованиеДиадок;
		НоваяСтрока.ИНН = СтрокаСортировки.ИНН;
		НоваяСтрока.КПП = СтрокаСортировки.КПП;
		НоваяСтрока.BoxId = СтрокаСортировки.BoxId;
		НоваяСтрока.ИдентификаторУчастникаЭДО = СтрокаСортировки.ИдентификаторУчастникаЭДО;
		НоваяСтрока.Результат = СтрокаСортировки.Результат;
	КонецЦикла;

КонецПроцедуры

&НаСервере
Процедура ДобавитьКандидата(ДанныеДиадок, Контрагент, Отправлять, ТекстРезультата)

	НоваяСтрока = Объект.КандидатыЭДО.Добавить();
	НоваяСтрока.Отправлять = Отправлять;
	НоваяСтрока.Контрагент = Контрагент;
	НоваяСтрока.НаименованиеДиадок = ДанныеДиадок.Наименование;
	НоваяСтрока.ИНН = ДанныеДиадок.ИНН;
	НоваяСтрока.КПП = ДанныеДиадок.КПП;
	НоваяСтрока.BoxId = ДанныеДиадок.ID;
	НоваяСтрока.ИдентификаторУчастникаЭДО = ДанныеДиадок.ИдентификаторУчастникаЭДО;
	НоваяСтрока.Результат = ТекстРезультата;

КонецПроцедуры

#КонецОбласти

#Область ПередачаВ1СЭДО

