&НаКлиенте
Перем мМодульПлатформаДиадок;

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// v0.1.21: база v0.1.20-r1. Добавлена жесткая проверка оператора получателя: роуминговая пачка допускает только FnsParticipantId Диадока с префиксом 2BM.
	// После dry-run кандидаты автоматически сортируются по наименованию контрагента.
	// Кнопка отправки работает только для точного статуса "требуется роуминговое приглашение".
	// Состояния разделены: требуется приглашение / приглашение уже отправлено / роуминг уже настроен.
	// Перед передачей в 1С-ЭДО выполняется повторная серверная проверка состояния и префикса 2BM.
	// Авторизация и все последующие вызовы Диадока
	// выполняются одним и тем же экземпляром штатной формы Модуль_ПлатформаУправляемая.
	// После Сеанс_Начать() контекст передается в общий серверный модуль Диадока
	// через штатный ПараметрыСеансаОбновитьКонтекст().
	// Отдельное серверное ядро нашей обработки для чтения Диадока больше не создается.
	// Выбор файла EPF не используется.
	// Здесь намеренно нет динамического ИзменитьРеквизиты()/Элементы.Добавить().
	Элементы.ФормаСоздатьДокументы.Заголовок = "Отправить роуминговое приглашение";
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура Заполнить(Команда)

	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Предупреждение("Выберите организацию, от имени которой будет выполняться приглашение в 1С-ЭДО.");
		Возврат;
	КонецЕсли;

	Попытка
		ДанныеСеанса = ПодготовитьСеансДиадокНаСервере();
	Исключение
		Предупреждение(
			"Не удалось обратиться к подключенному модулю Контур.Диадок." + Символы.ПС
			+ "Проверьте, что штатный модуль Диадок подключен в этой информационной базе." + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		Возврат;
	КонецПопытки;

	НачатьСеансДиадок(ДанныеСеанса);

КонецПроцедуры

&НаКлиенте
Процедура СоздатьДокументы(Команда)

	// Перед массовой операцией повторно читаем состояние 1С-ЭДО. Это защищает
	// от дубля, если приглашение/настройка появились после первоначального dry-run.
	ИтогПроверки = ПроверитьКандидатовПередОтправкойНаСервере();
	Если ИтогПроверки.КПередаче = 0 Тогда
		Предупреждение("После контрольной проверки нет строк со статусом «требуется роуминговое приглашение»." + Символы.ПС
			+ ИтогПроверки.Текст);
		Возврат;
	КонецЕсли;

	Сообщить("Контроль перед отправкой: " + ИтогПроверки.Текст);

	ТекстПодтверждения = СтрШаблон(
		"Будет подготовлено роуминговых приглашений: %1." + Символы.ПС
		+ "Каждый контрагент получит не более одного входящего роумингового приглашения в Контур.Диадок." + Символы.ПС
		+ "Если у контрагента не сработает автоматическое принятие, ему потребуется один раз принять приглашение в Диадоке." + Символы.ПС
		+ "Уже отправленные приглашения и уже настроенный роуминг повторно не отправляются." + Символы.ПС
		+ "В типовом помощнике 1С-ЭДО перед нажатием «Отправить» проверьте, что у каждой строки выбран ИдЭДО с префиксом 2BM. "
		+ "Идентификаторы 2AE/2AL/других операторов для этой роуминговой пачки недопустимы." + Символы.ПС + Символы.ПС
		+ "Продолжить?",
		ИтогПроверки.КПередаче);
	Если Вопрос(ТекстПодтверждения, РежимДиалогаВопрос.ДаНет) <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;

	ДанныеПередачи = ПолучитьДанныеДляПомощникаЭДОНаСервере();

	Если ДанныеПередачи.Контрагенты.Количество() = 0 Тогда
		Предупреждение("Не осталось ни одного безопасного кандидата для роумингового приглашения.");
		Возврат;
	КонецЕсли;

	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	ПараметрыФормы.Вставить("Контрагенты", ДанныеПередачи.Контрагенты);
	ПараметрыФормы.Вставить("СписокКонтрагентов", ДанныеПередачи.Контрагенты);
	ПараметрыФормы.Вставить("МассивКонтрагентов", ДанныеПередачи.Контрагенты);
	ПараметрыФормы.Вставить("ВыбранныеКонтрагенты", ДанныеПередачи.Контрагенты);
	ПараметрыФормы.Вставить("ДанныеКонтрагентов", ДанныеПередачи.ДанныеКонтрагентов);
	ПараметрыФормы.Вставить("ДанныеПриглашений", ДанныеПередачи.ДанныеКонтрагентов);
	ПараметрыФормы.Вставить("ИдентификаторыУчастниковЭДО", ДанныеПередачи.ИдентификаторыУчастниковЭДО);
	ПараметрыФормы.Вставить("ИдентификаторыКонтрагентовЭДО", ДанныеПередачи.ИдентификаторыУчастниковЭДО);
	ПараметрыФормы.Вставить("BoxIds", ДанныеПередачи.BoxIds);
	ПараметрыФормы.Вставить("КодОператораЭДО", "2BM");
	ПараметрыФормы.Вставить("КодОператораКонтрагента", "2BM");
	ПараметрыФормы.Вставить("РежимРоуминга", Истина);

	Попытка
		// Роуминговое приглашение создается/отправляется только типовым механизмом 1С-ЭДО.
		// Наша обработка отвечает за отбор, идентификаторы и защиту от дублей.
		ОткрытьФорму(
			"РегистрСведений.ПриглашенияКОбменуЭлектроннымиДокументами.Форма.ПомощникМассовойОтправкиПриглашений",
			ПараметрыФормы,
			ЭтаФорма);
	Исключение
		Предупреждение(
			"Не удалось открыть штатный помощник массовой отправки приглашений 1С-ЭДО." + Символы.ПС
			+ ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;

КонецПроцедуры

#КонецОбласти

#Область ИнтеграцияСДиадок

&НаКлиенте
Процедура НачатьСеансДиадок(ДанныеСеанса)

	Попытка
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ОбщийКонтекстКлиентСервер", ДанныеСеанса.ОбщийКонтекстКлиентСервер);

		мМодульПлатформаДиадок = ПолучитьФорму(
			ДанныеСеанса.ПутьКФормам + "Модуль_ПлатформаУправляемая",
